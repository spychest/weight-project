{% extends 'base.html.twig' %}

{% block title %}Mon sommeil{% endblock %}

{% block body %}
    <div class="entry-index">
        <header class="entry-index-header">
            <div>
                <span class="entry-index-label">🌙 Sommeil</span>
                <h1>Mon sommeil</h1>
                <p>Retrouve ici l'ensemble de ton sommeil enregistré.</p>
            </div>

            <a href="{{ path('app_dashboard') }}" class="dashboard-button dashboard-button-primary">
                Dashboard
            </a>

            <a href="{{ path('app_sleep_new') }}" class="dashboard-button dashboard-button-primary" data-modal-form>
                + Ajouter une nuit
            </a>
        </header>

        {% if sleepEntries is not empty %}
            <div class="entry-list">
                {% for sleepEntry in sleepEntries %}
                    <article class="entry-card">
                        <a href="{{ path('app_sleep_show', {id: sleepEntry.id}) }}" class="entry-card-link">
                            <div class="entry-card-header">
                                <div>
                                    <time>
                                        {{ sleepEntry.date|date('d/m/Y') }}
                                    </time>
                                </div>

                                <span class="entry-card-arrow">→</span>
                            </div>
                            <div class="entry-card-metrics">
                                <section class="entry-show-card">
                                    <div class="entry-show-section">
                                        <span class="entry-show-section-label">🌑 Couché</span>
                                        <p class="entry-show-description">{{ sleepEntry.bedTime | date('h:i') }}</p>
                                    </div>
                                </section>
                                <section class="entry-show-card">
                                    <div class="entry-show-section">
                                        <span class="entry-show-section-label">☀️ Réveil</span>
                                        <p class="entry-show-description">{{ sleepEntry.wakeUpTime | date('h:i') }}</p>
                                    </div>
                                </section>
                                <section class="entry-show-card">
                                    <div class="entry-show-section">
                                        <span class="entry-show-section-label">Qualité</span>
                                        <p class="entry-show-description">{{ sleepEntry.quality }}/10</p>
                                    </div>
                                </section>
                            </div>

                            {% if sleepEntry.note is not null %}
                                <p class="entry-card-description">
                                    {{ sleepEntry.note }}
                                </p>
                            {% endif %}
                        </a>
                    </article>
                {% endfor %}
            </div>
            {% include 'components/_pagination.html.twig' with {pagination: pagination, routeName: 'app_sleep_index'} only %}
        {% else %}
            <div class="entry-index-empty">
                <span>🍽️</span>
                <h2>Aucun sommeil enregistré</h2>
                <p>Commence à renseigner ton sommeil pour retrouver ton historique ici.</p>

                <a href="{{ path('app_sleep_new') }}" class="dashboard-button dashboard-button-primary" data-modal-form>
                    Ajouter mon premier sommeil
                </a>
            </div>
        {% endif %}
    </div>
{% endblock %}
