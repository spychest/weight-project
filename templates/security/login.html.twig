{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/password-visibility.js') }}?v=20260924-1" defer></script>
    <script src="{{ asset('js/remember-me.js') }}?v=20260925-1" defer></script>
{% endblock %}

{% block body %}
<main class="auth-page">
    <section class="auth-card">
        <h1>Content de te revoir</h1>
        {% if authentication_error %}
            <div class="alert">{{ authentication_error.messageKey|trans(authentication_error.messageData, 'security') }}</div>
        {% endif %}
        {% for message in app.flashes('error') %}<div class="alert">{{ message }}</div>{% endfor %}

        <form method="post">
            <label for="email">Adresse e-mail</label>
            <input id="email" type="email" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>

            <label for="password">Mot de passe</label>
            <div class="password-input-wrapper">
                <input id="password" type="password" name="_password" autocomplete="current-password" required data-password-input>
                <button
                    type="button"
                    class="password-visibility-button"
                    aria-label="Afficher le mot de passe"
                    aria-pressed="false"
                    title="Afficher le mot de passe"
                    data-password-toggle
                >
                    <svg data-password-visible-icon aria-hidden="true" viewBox="0 0 24 24">
                        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg data-password-hidden-icon aria-hidden="true" viewBox="0 0 24 24" hidden>
                        <path d="M3 3l18 18M10.6 6.2A10.7 10.7 0 0 1 12 6c6.5 0 10 6 10 6a17 17 0 0 1-3 3.7M6.4 6.4C3.6 8.2 2 12 2 12s3.5 6 10 6a10 10 0 0 0 3.6-.6M9.9 9.9a3 3 0 0 0 4.2 4.2"></path>
                    </svg>
                </button>
            </div>

            <label class="remember-me-option" for="remember-me">
                <input id="remember-me" type="checkbox" name="_remember_me" value="1" data-remember-me>
                <span>
                    Rester connecté
                    <small>Même après la fermeture du navigateur, pendant 30 jours.</small>
                </span>
            </label>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button class="button" type="submit">Se connecter</button>
        </form>

        <div class="auth-separator"><span>ou</span></div>
        <a class="button button-google" href="{{ path('app_google_connect') }}" data-google-connect>Continuer avec Google</a>
        <p>Pas encore de compte ? <a href="{{ path('app_register') }}">S’inscrire</a></p>
    </section>
</main>
{% endblock %}
