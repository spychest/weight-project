{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block body %}<main class="auth-page"><section class="auth-card">
<h1>Content de te revoir</h1>
{% if authentication_error %}<div class="alert">{{ authentication_error.messageKey|trans(authentication_error.messageData, 'security') }}</div>{% endif %}
{% for message in app.flashes('error') %}<div class="alert">{{ message }}</div>{% endfor %}
<form method="post"><label for="email">Adresse e-mail</label><input id="email" type="email" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus><label for="password">Mot de passe</label><input id="password" type="password" name="_password" autocomplete="current-password" required><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button class="button" type="submit">Se connecter</button></form>
<div class="auth-separator"><span>ou</span></div><a class="button button-google" href="{{ path('app_google_connect') }}">Continuer avec Google</a><p>Pas encore de compte ? <a href="{{ path('app_register') }}">S’inscrire</a></p>
</section></main>{% endblock %}
