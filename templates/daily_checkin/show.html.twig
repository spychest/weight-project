{% extends 'base.html.twig' %}

{% block title %}Bilan{% endblock %}

{% block body %}
    <div class="entry-show">
        <header class="entry-show-header">
            <div>
                <span class="entry-show-label">📋 bilans</span>
                <p>{{ dailyCheckin.date|date('d/m/Y') }}</p>
            </div>

            <div class="entry-show-actions">
                <a href="{{ path('app_daily_checkin_edit', {id: dailyCheckin.id}) }}" class="dashboard-button dashboard-button-primary">
                    Modifier
                </a>

                <a href="{{ path('app_daily_checkin_index') }}" class="dashboard-button">
                    Retour
                </a>
            </div>
        </header>

        <section class="entry-show-card">
            <div class="entry-show-metrics">
                <div class="entry-show-metric">
                    <span>Niveau moral</span>
                    <strong>{{ dailyCheckin.moodLevel }}/10</strong>
                </div>
                <div class="entry-show-metric">
                    <span>Niveau d'énergie</span>
                    <strong>{{ dailyCheckin.energyLevel }}/10</strong>
                </div>
                <div class="entry-show-metric">
                    <span>Niveau de frustration</span>
                    <strong>{{ dailyCheckin.frustrationLevel }}/10</strong>
                </div>
                <div class="entry-show-metric">
                    <span>Niveau de douleur</span>
                    <strong>{{ dailyCheckin.painLevel }}/10</strong>
                </div>
            </div>


            {% if dailyCheckin.note is not null %}
                <div class="entry-show-section">
                    <span class="entry-show-section-label">Note</span>
                    <p>{{ dailyCheckin.note }}</p>
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}