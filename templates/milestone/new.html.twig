{% extends 'base.html.twig' %}

{% block title %}{{ editMode ? 'Modifier le jalon' : 'Ajouter un jalon' }}{% endblock %}

{% block body %}
    <div class="form-page">
        <div class="form-card">
            <header class="form-header">
                <h1>{{ editMode ? 'Modifier le jalon' : 'Ajouter un jalon' }} 🎯</h1>
                <p>{{ editMode ? 'Mets à jour les informations de ce jalon.' : 'Définis un objectif intermédiaire pour suivre ta progression.' }}</p>
            </header>

            {{ form_start(form) }}

            <div class="form-grid">
                {{ form_row(form.title) }}
                {{ form_row(form.type) }}
                {{ form_row(form.targetValue) }}
                {{ form_row(form.description) }}
            </div>

            <div class="form-actions">
                <button type="submit" class="form-button form-button-primary">
                    {{ editMode ? 'Enregistrer les modifications' : 'Ajouter le jalon' }}
                </button>
                {% if editMode %}
                    <a href="{{ path('app_milestone_show', {id: form.vars.data.id}) }}" class="form-button">Annuler</a>
                {% endif %}
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
