{% extends 'base.html.twig' %}

{% block title %}Ajouter un jalon{% endblock %}

{% block body %}
    <div class="form-page">
        <div class="form-card">
            <header class="form-header">
                <h1>Ajouter un jalon 🎯</h1>
                <p>Définis un objectif intermédiaire pour suivre ta progression.</p>
            </header>

            {{ form_start(form) }}

            <div class="form-grid">
                {{ form_row(form.title) }}
                {{ form_row(form.type) }}
                {{ form_row(form.targetValue) }}
                {{ form_row(form.description) }}
            </div>

            <div class="form-actions">
                <button type="submit" class="form-button form-button-primary">
                    Ajouter le jalon
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
