{% extends 'base.html.twig' %}

{% block title %}Rapport de suivi pondéral{% endblock %}

{% block body %}
    <main class="report report-medical-preview">
        <header class="report-header">
            <span class="entry-index-label">📄 Document pour consultation</span>
            <h1>Rapport de suivi pondéral</h1>
            <p class="report-period">
                Indicateurs alimentaires du {{ report.startDate|date('d/m/Y') }} au {{ report.endDate|date('d/m/Y') }}.
                L’évolution pondérale couvrira tout l’historique disponible.
            </p>
        </header>

        <section class="report-export-card">
            <div>
                <h2>Avant de télécharger</h2>
                <p>Tu peux encore ajuster les deux synthèses facultatives. Aucun diagnostic ne sera généré automatiquement.</p>
            </div>

            <form method="post" action="{{ path('app_report_pdf', {
                startDate: report.startDate|date('Y-m-d'),
                endDate: report.endDate|date('Y-m-d')
            }) }}" class="report-export-form">
                <label for="habit-summary">Évolution des habitudes</label>
                <textarea id="habit-summary" name="habitSummary" maxlength="350" rows="4">{{ habitSummary }}</textarea>
                <small>350 caractères maximum. Ne renseigne que les changements que tu souhaites communiquer.</small>

                <label for="medical-notes">Informations complémentaires</label>
                <textarea id="medical-notes" name="medicalNotes" maxlength="350" rows="4">{{ medicalNotes }}</textarea>
                <small>Ressenti, symptômes, limitations ou questions pour le médecin.</small>

                <div class="report-export-actions">
                    <a href="{{ path('app_report') }}" class="dashboard-button dashboard-button-secondary">Modifier la période</a>
                    <a href="{{ path('app_report_data', {
                        startDate: report.startDate|date('Y-m-d'),
                        endDate: report.endDate|date('Y-m-d')
                    }) }}" class="dashboard-button dashboard-button-secondary">Exporter les données JSON</a>
                    <button type="submit" class="dashboard-button dashboard-button-primary">Télécharger le PDF médical</button>
                </div>
            </form>
        </section>

        <section class="report-preview-summary">
            <article><span>Poids initial officiel</span><strong>Données du profil</strong></article>
            <article><span>Courbe pondérale</span><strong>Historique complet</strong></article>
            <article><span>Tendances</span><strong>Générale et 30 jours</strong></article>
            <article><span>Format</span><strong>1 page A4</strong></article>
        </section>
    </main>
{% endblock %}
