{% extends 'base.html.twig' %}

{% block title %}Hello ReportController!{% endblock %}

{% block body %}
    <div class="form-page">
        <div class="form-card">
            <header class="form-header">
                <h1>Générer compte-rendu</h1>
            </header>

            {{ form_start(form) }}

            <div class="form-grid">
                {{ form_row(form.startDate) }}
                {{ form_row(form.endDate) }}
            </div>

            <div class="form-actions">
                <button type="submit" class="form-button form-button-primary">
                    Générer le compte-rendu
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
