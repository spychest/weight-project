{% extends 'base.html.twig' %}

{% block title %}Préparer le rapport médical{% endblock %}

{% block body %}
    <div class="form-page report-form-page">
        <div class="form-card report-form-card">
            <header class="form-header">
                <span class="entry-index-label">📄 Synthèse médicale</span>
                <h1>Préparer le rapport pondéral</h1>
                <p>Le poids utilisera tout ton historique. La période choisie sert uniquement aux indicateurs alimentaires facultatifs.</p>
            </header>

            {{ form_start(form) }}
                <div class="form-grid report-form-date-fields">
                    {{ form_row(form.startDate) }}
                    {{ form_row(form.endDate) }}
                </div>

                <div class="form-grid report-form-textareas">
                    {{ form_row(form.habitSummary) }}
                    {{ form_row(form.medicalNotes) }}
                </div>

                <p class="report-form-privacy-note">
                    Ces textes sont facultatifs et ne servent qu’à composer le document que tu télécharges.
                </p>

                <div class="form-actions">
                    <button type="submit" class="form-button form-button-primary">Prévisualiser le rapport</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
