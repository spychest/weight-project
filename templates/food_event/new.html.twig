{% extends 'base.html.twig' %}

{% block body %}
    <div class="form-page">
        <div class="form-card">
            <header class="form-header">
                <h1>Ajouter un repas</h1>
            </header>

            {{ form_start(form) }}

            <div class="form-grid">
                {{ form_row(form.mealType) }}
                {{ form_row(form.eatenAt) }}
                {{ form_row(form.description) }}
                {{ form_row(form.hungerLevel) }}
                {{ form_row(form.pleasureLevel) }}
                {{ form_row(form.cause) }}
                {{ form_row(form.note) }}
            </div>

            <div class="form-actions">
                <button type="submit" class="form-button form-button-primary">
                    Ajouter la pesée
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>

{% endblock %}