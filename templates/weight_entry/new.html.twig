{% extends 'base.html.twig' %}

{% block title %}Hello WeightEntryController!{% endblock %}

{% block body %}
    <div class="form-page">
        <div class="form-card">
            <header class="form-header">
                <h1>Ajouter une pesée</h1>
                <p>Définis un objectif intermédiaire pour suivre ta progression.</p>
            </header>

            {{ form_start(form) }}

            <div class="form-grid">
                {{ form_row(form.weight) }}
                {{ form_row(form.measuredAt) }}
                {{ form_row(form.note) }}
            </div>

            <div class="form-actions">
                <button type="submit" class="form-button form-button-primary">
                    {% if editMod is true %}
                        Modifier
                    {% else %}
                        Ajouter la pesée
                    {% endif %}
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
