{% extends 'base.html.twig' %}

{% block title %}Pesée{% endblock %}

{% block body %}
    <div class="entry-show">
        <header class="entry-show-header">
            <div>
                <span class="entry-show-label">⚖️ Pesée</span>
                <h1>{{ weightEntry.measuredAt|date('d/m/Y à H:i') }}</h1>
            </div>

            <div class="entry-show-actions">
                <a href="{{ path('app_weight_edit', {id: weightEntry.id}) }}" class="dashboard-button dashboard-button-primary" data-modal-form>
                    Modifier
                </a>

                <a href="{{ path('app_weight_index') }}" class="dashboard-button">
                    Retour
                </a>
            </div>
        </header>

        <section class="entry-show-card">
            <div class="entry-show-section">
                <span class="entry-show-section-label">Pesée</span>
            </div>

            <div class="entry-show-metrics">
                <div class="entry-show-metric">
                    <span>Poids mesuré</span>
                    <strong>{{ weightEntry.weight }}kg</strong>
                </div>
            </div>
            {% if weightEntry.note %}
                <div class="entry-show-section">
                    <span class="entry-show-section-label">Note</span>
                    <p>{{ weightEntry.note }}</p>
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}
