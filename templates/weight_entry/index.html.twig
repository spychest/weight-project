{% extends 'base.html.twig' %}

{% block title %}Mes pesées{% endblock %}

{% block body %}
    <div class="entry-index">
        <header class="entry-index-header">
            <div>
                <span class="entry-index-label">⚖️ Poids</span>
                <h1>Mes pesées</h1>
                <p>Retrouve ici l'ensemble de tes pesées enregistrées.</p>
            </div>

            <a href="{{ path('app_dashboard') }}" class="dashboard-button dashboard-button-primary">
                Dashboard
            </a>

            <a href="{{ path('app_weight_new') }}" class="dashboard-button dashboard-button-primary">
                + Ajouter une pesé
            </a>
        </header>

        {% if weightEntries is not empty %}
            <div class="entry-list">
                {% for weightEntry in weightEntries %}
                    <article class="entry-card">
                        <a href="{{ path('app_weight_show', {id: weightEntry.id}) }}" class="entry-card-link">
                            <div class="entry-card-header">
                                <div>
                                    <time>
                                        {{ weightEntry.measuredAt|date('d/m/Y') }}
                                    </time>
                                </div>

                                <span class="entry-card-arrow">→</span>
                            </div>
                            <div class="entry-card-metrics">
                                <section class="entry-show-card">
                                    <div class="entry-show-section">
                                        <span class="entry-show-section-label">Poids mesuré</span>
                                        <p class="entry-show-description">{{ weightEntry.weight }}kg</p>
                                    </div>
                                </section>
                            </div>

                            {% if weightEntry.note is not null %}
                                <p class="entry-card-description">
                                    <span class="bold">Note: </span>{{ weightEntry.note }}
                                </p>
                            {% endif %}
                        </a>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="entry-index-empty">
                <span>⚖️ </span>
                <h2>Aucune pesée enregistrée</h2>
                <p>Commence à renseigner tes pesées pour retrouver ton historique ici.</p>

                <a href="{{ path('app_weight_new') }}" class="dashboard-button dashboard-button-primary">
                    Ajouter ma première pesée
                </a>
            </div>
        {% endif %}
    </div>
{% endblock %}