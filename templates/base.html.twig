<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Mon suivi de poids{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="{{ asset('css/style.css') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}

        {% endblock %}
    </head>
    <body>
        {% if app.user %}
        <header class="site-header site-header-authenticated">
            <nav class="site-navigation">
                <a class="navigation-link" href="{{ path('app_dashboard') }}">Tableau de bord</a>
                <a class="navigation-link" href="{{ path('app_account') }}">Mon compte</a>
                <span class="authenticated-user-email">{{ app.user.userIdentifier }}</span>
                <a class="navigation-button navigation-button-logout" href="{{ path('app_logout') }}">Déconnexion</a>
            </nav>
        </header>
        {% elseif app.request.attributes.get('_route') != 'app_home' %}
        <div class="public-page-navigation">
            <a href="{{ path('app_home') }}">← Retour à l’accueil</a>
        </div>
        {% endif %}
        {% block body %}{% endblock %}
    </body>
</html>
