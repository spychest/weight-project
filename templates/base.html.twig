<!DOCTYPE html>
<html{% if app.user and app.user.darkModeEnabled %} class="dark-mode"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Mon suivi de poids{% endblock %}</title>
        <meta name="theme-color" content="#174f3c">
        <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}?v=20260924-1">
        <link rel="stylesheet" href="{{ asset('css/style.css') }}?v=20260925-3">
        {% if app.user %}
            <script src="{{ asset('js/modal-forms.js') }}?v=20260903-1" defer></script>
            <script src="{{ asset('js/recipe-form.js') }}?v=20260925-1" defer></script>
            <script src="{{ asset('js/recipe-tabs.js') }}?v=20260926-2" defer></script>
            <script src="{{ asset('js/favorite-meals.js') }}?v=20260922-1" defer></script>
            <script src="{{ asset('js/shopping-list.js') }}?v=20260924-1" defer></script>
            <script src="{{ asset('js/profile-avatar-preview.js') }}?v=20260924-1" defer></script>
        {% endif %}
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}

        {% endblock %}
    </head>
    <body>
        {% if app.user %}
        {% set navigationProfile = app.user.profile %}
        {% set navigationDisplayName = navigationProfile ? navigationProfile.displayName : 'Nouveau membre' %}
        {% set navigationAvatarUrl = navigationProfile and navigationProfile.avatarFilename
            ? asset('uploads/profiles/' ~ navigationProfile.avatarFilename)
            : (navigationProfile ? navigationProfile.googleAvatarUrl : null) %}
        <header class="site-header site-header-authenticated">
            <nav class="site-navigation site-navigation-desktop" aria-label="Navigation principale">
                <a class="navigation-link" href="{{ path('app_dashboard') }}">Tableau de bord</a>
                {% set unseenRecipeCount = unseen_recipe_count() %}
                <a class="navigation-link navigation-link-with-badge" href="{{ path('app_recipe_index') }}">
                    Recettes
                    {% if unseenRecipeCount > 0 %}<span class="navigation-badge" aria-label="{{ unseenRecipeCount }} recette(s) non vue(s)">{{ unseenRecipeCount }}</span>{% endif %}
                </a>
                {% set activeShoppingList = active_shopping_list_summary() %}
                {% if activeShoppingList %}
                    <a class="navigation-link navigation-link-with-badge" href="{{ path('app_shopping_list_show') }}">
                        Liste de courses
                        {% if activeShoppingList.remaining > 0 %}<span class="navigation-badge">{{ activeShoppingList.remaining }}</span>{% endif %}
                    </a>
                {% endif %}
                <a class="navigation-link" href="{{ path('app_account') }}">Mon compte</a>
                {% if is_granted('ROLE_ADMIN') %}<a class="navigation-link navigation-link-admin" href="{{ path('app_admin_index') }}">Administration</a>{% endif %}
                <span class="authenticated-user-identity">
                    {% if navigationAvatarUrl %}
                        <img src="{{ navigationAvatarUrl }}" alt="" class="navigation-avatar">
                    {% else %}
                        <span class="navigation-avatar navigation-avatar-fallback" aria-hidden="true">{{ navigationDisplayName|first|upper }}</span>
                    {% endif %}
                    <span>{{ navigationDisplayName }}</span>
                </span>
                <a class="navigation-button navigation-button-logout" href="{{ path('app_logout') }}">Déconnexion</a>
            </nav>
            <details class="mobile-navigation">
                <summary class="mobile-navigation-toggle">
                    <span class="mobile-navigation-label">Menu</span>
                    <span class="burger-icon" aria-hidden="true"><span></span><span></span><span></span></span>
                </summary>
                <nav class="mobile-navigation-panel" aria-label="Navigation mobile">
                    <a href="{{ path('app_dashboard') }}">Tableau de bord</a>
                    <a href="{{ path('app_recipe_index') }}">
                        Recettes
                        {% if unseenRecipeCount > 0 %}<span class="navigation-badge" aria-label="{{ unseenRecipeCount }} recette(s) non vue(s)">{{ unseenRecipeCount }}</span>{% endif %}
                    </a>
                    {% if activeShoppingList %}
                        <a href="{{ path('app_shopping_list_show') }}">Liste de courses{% if activeShoppingList.remaining > 0 %} <span class="navigation-badge">{{ activeShoppingList.remaining }}</span>{% endif %}</a>
                    {% endif %}
                    <a href="{{ path('app_account') }}">Mon compte</a>
                    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_admin_index') }}">Administration</a>{% endif %}
                    <span class="mobile-navigation-identity">
                        {% if navigationAvatarUrl %}
                            <img src="{{ navigationAvatarUrl }}" alt="" class="navigation-avatar">
                        {% else %}
                            <span class="navigation-avatar navigation-avatar-fallback" aria-hidden="true">{{ navigationDisplayName|first|upper }}</span>
                        {% endif %}
                        <span>{{ navigationDisplayName }}</span>
                    </span>
                    <a class="mobile-navigation-logout" href="{{ path('app_logout') }}">Déconnexion</a>
                </nav>
            </details>
        </header>
        {% elseif app.request.attributes.get('_route') != 'app_home' %}
        <div class="public-page-navigation">
            <a href="{{ path('app_home') }}">← Retour à l’accueil</a>
        </div>
        {% endif %}
        {% block body %}{% endblock %}
        {% if app.user %}
            <dialog class="form-modal" data-form-modal aria-label="Formulaire">
                <div class="form-modal-content" data-form-modal-content></div>
            </dialog>
        {% endif %}
    </body>
</html>
