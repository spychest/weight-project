<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page { margin: 34px 42px 46px; } body { color:#17211e; font-family:"DejaVu Sans",sans-serif; font-size:12px; } h1 { margin:3px 0 5px; font-size:28px; } .kicker { color:#16745b; font-size:10px; font-weight:bold; letter-spacing:2px; text-transform:uppercase; } .meta { color:#60716c; margin-bottom:22px; } .category { page-break-inside:avoid; margin:0 0 18px; } h2 { border-bottom:2px solid #dce9e4; color:#17664f; font-size:16px; padding-bottom:6px; } table { border-collapse:collapse; width:100%; } td { border-bottom:1px solid #e7eeeb; padding:7px 3px; } .box { border:1px solid #78958c; display:inline-block; height:12px; margin-right:9px; vertical-align:middle; width:12px; } .quantity { font-weight:bold; text-align:right; width:32%; } footer { border-top:1px solid #b9cbc5; color:#537068; margin-top:28px; padding-top:10px; }
</style></head><body>
<p class="kicker">Mon suivi bien-être</p><h1>{{ shoppingList.displayName }}</h1><p class="meta">{{ shoppingList.remainingItemCount }} produit(s) restant(s) · Mise à jour le {{ shoppingList.updatedAt|date('d/m/Y à H:i') }}</p>
{% for category, items in itemsByCategory %}<section class="category"><h2>{{ category }}</h2><table>{% for item in items %}<tr><td><span class="box"></span>{{ item.name }}</td><td class="quantity">{% if category != 'Épices et condiments' %}{{ item.quantity|number_format(2, ',', ' ')|trim('0', 'right')|trim(',', 'right') }} {{ item.unit }}{% endif %}</td></tr>{% endfor %}</table></section>{% endfor %}
<footer>Liste générée depuis weight.spychest.fr</footer></body></html>
