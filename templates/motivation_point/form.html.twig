{% extends 'base.html.twig' %}

{% block title %}{{ editMode ? 'Modifier la motivation' : 'Ajouter une motivation' }}{% endblock %}

{% block body %}
    <div class="form-page">
        <div class="form-card motivation-point-form-card">
            <header class="motivation-point-form-header">
                <span class="motivation-point-form-icon" aria-hidden="true">💚</span>
                <div>
                    <span class="motivation-point-form-kicker">Ce qui compte pour moi</span>
                    <h1>{{ editMode ? 'Modifier ma motivation' : 'Ajouter une motivation' }}</h1>
                    <p>Écris une raison personnelle qui t’aide à garder le cap, indépendamment de tout chiffre.</p>
                </div>
            </header>

            {{ form_start(form) }}
                <div class="motivation-point-form-field">
                    {{ form_label(form.content) }}
                    {{ form_widget(form.content) }}
                    <div class="motivation-point-form-help">
                        <span>Une phrase simple, positive et personnelle.</span>
                        <span>500 caractères maximum</span>
                    </div>
                    {{ form_errors(form.content) }}
                </div>
                <div class="form-actions">
                    <button type="submit" class="form-button form-button-primary">
                        {{ editMode ? 'Enregistrer la modification' : 'Ajouter la motivation' }}
                    </button>
                    <a href="{{ path('app_motivation_point_index') }}" class="form-button form-button-secondary" data-modal-close>Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
