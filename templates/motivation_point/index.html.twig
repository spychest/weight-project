{% extends 'base.html.twig' %}

{% block title %}Mes motivations{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/motivation-points.js') }}?v=20260930-1" defer></script>
{% endblock %}

{% block body %}
    <main class="entry-index motivation-point-page">
        <header class="entry-index-header">
            <div>
                <span class="entry-index-label">💚 Ce qui compte pour moi</span>
                <h1>Mes motivations</h1>
                <p>Classe tes raisons de la plus importante à la moins importante et relis-les quand tu en as besoin.</p>
            </div>
            <a href="{{ path('app_motivation_point_new') }}" class="dashboard-button dashboard-button-primary motivation-point-add-button" data-modal-form>Ajouter une motivation</a>
        </header>

        {% for successMessage in app.flashes('success') %}
            <p class="account-success-message">{{ successMessage }}</p>
        {% endfor %}

        {% if motivationPoints is empty %}
            <div class="entry-index-empty">
                <span>💚</span>
                <h2>Aucune motivation enregistrée</h2>
                <p>Commence par la raison qui compte le plus pour toi.</p>
                <a href="{{ path('app_motivation_point_new') }}" class="dashboard-button dashboard-button-primary" data-modal-form>Ajouter ma première motivation</a>
            </div>
        {% else %}
            <p class="motivation-point-reorder-help">Fais glisser les poignées pour classer tes motivations.</p>
            <p class="motivation-point-reorder-status" data-motivation-reorder-status aria-live="polite"></p>
            <ol
                class="motivation-point-list"
                data-motivation-list
                data-reorder-url="{{ path('app_motivation_point_reorder') }}"
                data-reorder-token="{{ csrf_token('reorder-motivation-points') }}"
            >
                {% for motivationPoint in motivationPoints %}
                    <li class="motivation-point-item" data-motivation-item data-motivation-id="{{ motivationPoint.id }}">
                        <button
                            type="button"
                            class="motivation-point-drag-handle"
                            data-motivation-drag-handle
                            aria-label="Déplacer la motivation {{ loop.index }}"
                            title="Faire glisser pour réordonner"
                        >⋮⋮</button>
                        <span class="motivation-point-rank" aria-label="Position {{ loop.index }}">{{ loop.index }}</span>
                        <p>{{ motivationPoint.content }}</p>
                        <div class="motivation-point-actions">
                            <a href="{{ path('app_motivation_point_edit', {id: motivationPoint.id}) }}" data-modal-form>Modifier</a>
                            <form method="post" action="{{ path('app_motivation_point_delete', {id: motivationPoint.id}) }}" onsubmit="return confirm('Supprimer cette motivation ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-motivation-point-' ~ motivationPoint.id) }}">
                                <button type="submit" class="motivation-point-delete">Supprimer</button>
                            </form>
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
    </main>
{% endblock %}
