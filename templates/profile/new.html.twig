{% extends 'base.html.twig' %}

{% block title %}{{ editMode ? 'Modifier mon profil' : 'Créer mon profil' }}{% endblock %}

{% block body %}
    <div class="form-page">
        <div class="form-card">
            <header class="form-header">
                <h1>{{ editMode ? 'Modifier mon profil' : 'Bienvenue 👋' }}</h1>
                <p>{{ editMode ? 'Mets à jour tes informations et tes objectifs.' : 'Pour commencer ton suivi, renseigne quelques informations.' }}</p>
            </header>

        {{ form_start(form) }}
        <div class="form-grid">
            {{ form_row(form.height) }}
            {{ form_row(form.birthDate) }}
            {{ form_row(form.biologicalGender) }}
            {{ form_row(form.startingWeight) }}
            {{ form_row(form.targetWeight) }}
        </div>
        <div class="form-actions">
            <button type="submit" class="form-button form-button-primary">
                {{ editMode ? 'Enregistrer les modifications' : 'Commencer mon suivi' }}
            </button>
            {% if editMode %}<a href="{{ path('app_dashboard') }}" class="form-button">Annuler</a>{% endif %}
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
