{% if pagination.totalPages > 1 %}
    {% set pageParameterName = pageParameterName|default('page') %}
    {% set preservedQueryParameters = preservedQueryParameters|default({}) %}
    <nav class="pagination" aria-label="Navigation entre les pages">
        {% if pagination.hasPreviousPage %}
            <a class="pagination-link pagination-direction-link" href="{{ path(routeName, preservedQueryParameters|merge({(pageParameterName): pagination.currentPage - 1})) }}" rel="prev">
                ← Précédente
            </a>
        {% else %}
            <span class="pagination-link pagination-direction-link pagination-link-disabled" aria-disabled="true">← Précédente</span>
        {% endif %}

        {% set secondPreviousPage = pagination.currentPage - 2 %}
        {% set secondFollowingPage = pagination.currentPage + 2 %}
        {% set firstVisiblePage = secondPreviousPage > 1 ? secondPreviousPage : 1 %}
        {% set lastVisiblePage = secondFollowingPage < pagination.totalPages ? secondFollowingPage : pagination.totalPages %}
        <div class="pagination-page-links" aria-label="Pages disponibles">
            {% for pageNumber in firstVisiblePage..lastVisiblePage %}
                {% if pageNumber == pagination.currentPage %}
                    <span class="pagination-page-link pagination-page-link-current" aria-current="page">
                        {{ pageNumber }}
                    </span>
                {% else %}
                    <a class="pagination-page-link" href="{{ path(routeName, preservedQueryParameters|merge({(pageParameterName): pageNumber})) }}">
                        {{ pageNumber }}
                    </a>
                {% endif %}
            {% endfor %}
        </div>

        {% if pagination.hasNextPage %}
            <a class="pagination-link pagination-direction-link" href="{{ path(routeName, preservedQueryParameters|merge({(pageParameterName): pagination.currentPage + 1})) }}" rel="next">
                Suivante →
            </a>
        {% else %}
            <span class="pagination-link pagination-direction-link pagination-link-disabled" aria-disabled="true">Suivante →</span>
        {% endif %}
    </nav>
{% endif %}
