{% extends 'base.html.twig' %}

{% block title %}Recettes{% endblock %}

{% block body %}
    <main class="recipe-page">
        <header class="recipe-page-header">
            <div><p class="recipe-page-kicker">La cuisine de la communauté</p><h1>Recettes</h1><p>Découvre les recettes partagées par les utilisateurs.</p></div>
            <div class="recipe-page-actions">
                <a href="{{ path('app_recipe_new') }}" class="dashboard-button dashboard-button-primary" data-modal-form>＋ Ajouter une recette</a>
            </div>
        </header>

        {% include 'recipe/_tabs.html.twig' with {activeTab: activeRecipeTab} only %}

        {% for message in app.flashes('success') %}<p class="account-success-message">{{ message }}</p>{% endfor %}

        <section class="recipe-tab-panel" data-recipe-tab-panel="community"{{ activeRecipeTab != 'community' ? ' hidden' : '' }}>
            <form class="recipe-filters" method="get" action="{{ path('app_recipe_index') }}" data-recipe-filters>
                <input type="hidden" name="tab" value="community">
                <label>
                    <span>Proposée par</span>
                    <input type="search" name="author" value="{{ recipeFilters.author }}" placeholder="Rechercher un pseudo…" autocomplete="off">
                </label>
                <label>
                    <span>Publiée le</span>
                    <input type="date" name="publicationDate" value="{{ recipeFilters.publicationDate }}">
                </label>
                <fieldset class="recipe-dietary-filters">
                    <legend>Régimes</legend>
                    <label><input type="checkbox" name="vegetarian" value="1"{{ recipeFilters.vegetarian ? ' checked' : '' }}> Végétarien</label>
                    <label><input type="checkbox" name="vegan" value="1"{{ recipeFilters.vegan ? ' checked' : '' }}> Végan</label>
                    <label><input type="checkbox" name="glutenFree" value="1"{{ recipeFilters.glutenFree ? ' checked' : '' }}> Sans gluten</label>
                </fieldset>
                {% if recipeFilters.author or recipeFilters.publicationDate or recipeFilters.vegetarian or recipeFilters.vegan or recipeFilters.glutenFree %}
                    <div class="recipe-filter-actions">
                        <a href="{{ path('app_recipe_index', {tab: 'community'}) }}" class="dashboard-button" data-recipe-filters-reset>Réinitialiser</a>
                    </div>
                {% endif %}
            </form>
            {% if communityRecipesPagination.items is empty %}
                {% set hasRecipeFilter = recipeFilters.author or recipeFilters.publicationDate or recipeFilters.vegetarian or recipeFilters.vegan or recipeFilters.glutenFree %}
                <div class="recipe-empty-state"><span>🍽️</span><h2>Aucune recette trouvée</h2><p>{{ hasRecipeFilter ? 'Aucune recette ne correspond à ces filtres.' : 'Sois la première personne à en partager une.' }}</p>{% if not hasRecipeFilter %}<a href="{{ path('app_recipe_new') }}" class="dashboard-button dashboard-button-primary" data-modal-form>Ajouter une recette</a>{% endif %}</div>
            {% else %}
                <div class="recipe-grid">{% for recipe in communityRecipesPagination.items %}{% include 'recipe/_card.html.twig' with {recipe: recipe} only %}{% endfor %}</div>
                {% include 'components/_pagination.html.twig' with {pagination: communityRecipesPagination, routeName: 'app_recipe_index', pageParameterName: 'communityPage', preservedQueryParameters: {tab: 'community', minePage: personalRecipesPagination.currentPage, author: recipeFilters.author, publicationDate: recipeFilters.publicationDate, vegetarian: recipeFilters.vegetarian ? 1 : 0, vegan: recipeFilters.vegan ? 1 : 0, glutenFree: recipeFilters.glutenFree ? 1 : 0}} only %}
            {% endif %}
        </section>

        <section class="recipe-tab-panel" data-recipe-tab-panel="mine"{{ activeRecipeTab != 'mine' ? ' hidden' : '' }}>
            {% if personalRecipesPagination.items is empty %}
                <div class="recipe-empty-state"><span>📝</span><h2>Tu n’as pas encore de recette</h2><a href="{{ path('app_recipe_new') }}" class="dashboard-button dashboard-button-primary" data-modal-form>Créer ma première recette</a></div>
            {% else %}
                <div class="recipe-management-list">
                    {% for recipe in personalRecipesPagination.items %}
                        <article class="recipe-management-row">
                            <div>
                                <h2><a href="{{ path('app_recipe_show', {id: recipe.id}) }}">{{ recipe.title }}</a></h2>
                                <p>Proposée le {{ recipe.createdAt|date('d/m/Y') }} · Mise à jour le {{ recipe.updatedAt|date('d/m/Y') }} · {{ recipe.uniqueViewCount }} vue{{ recipe.uniqueViewCount > 1 ? 's' : '' }}</p>
                                {% include 'recipe/_dietary_badges.html.twig' with {recipe: recipe} only %}
                            </div>
                            <div class="recipe-management-actions"><a href="{{ path('app_recipe_show', {id: recipe.id}) }}" class="dashboard-button">Voir</a><a href="{{ path('app_recipe_edit', {id: recipe.id}) }}" class="dashboard-button dashboard-button-primary" data-modal-form>Modifier</a></div>
                        </article>
                    {% endfor %}
                </div>
                {% include 'components/_pagination.html.twig' with {pagination: personalRecipesPagination, routeName: 'app_recipe_index', pageParameterName: 'minePage', preservedQueryParameters: {tab: 'mine', communityPage: communityRecipesPagination.currentPage, author: recipeFilters.author, publicationDate: recipeFilters.publicationDate, vegetarian: recipeFilters.vegetarian ? 1 : 0, vegan: recipeFilters.vegan ? 1 : 0, glutenFree: recipeFilters.glutenFree ? 1 : 0}} only %}
            {% endif %}
        </section>
    </main>
{% endblock %}
