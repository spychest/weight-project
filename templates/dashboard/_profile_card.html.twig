
<div class="dashboard-profile-card">
    <div class="dashboard-profile-icon">
        👤
    </div>
    <div class="dashboard-profile-content">
        <span class="dashboard-card-label">Profil</span>
        <div class="dashboard-profile-values">
            <div>
                <span>Taille</span>
                <strong>{{ dashboard.height }} m</strong>
            </div>
            <div>
                <span>Objectif</span>
                <strong>{{ dashboard.targetWeight }} kg</strong>
            </div>
            <div>
                <span>IMC de départ</span>
                <strong>{{ dashboard.imc }}</strong>
            </div>
            <div>
                <span>IMC actuel</span>
                <strong>{{ dashboard.currentImc }}</strong>
            </div>
            <div>
                <span>IMC cible</span>
                <strong>{{ dashboard.targetImc }}</strong>
            </div>
        </div>
    </div>
    <div class="dashboard-profile-actions">
        <a
                href="{{ path('app_report') }}"
                class="dashboard-profile-button"
        >
            📋 Comptes-rendus
        </a>
    </div>
</div>
