{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    {% include 'dashboard/_profile_card.html.twig' %}
    <h1>Suivi poids</h1>

    <a href="{{ path('app_food_new') }}">
        Ajouter un repas
    </a>

    <a href="{{ path('app_drink_new') }}">
        Ajouter hydratation
    </a>

    <ul>
        <li>Taille : {{ dashboard.height }} m</li>
        <li>Poids départ : {{ dashboard.startingWeight }} kg</li>
        <li>Poids actuel : {{ dashboard.currentWeight }} kg</li>
        <li>Objectif : {{ dashboard.targetWeight }} kg</li>
        <li>Perdu : {{ dashboard.lostWeight }} kg</li>
        <li>Restant : {{ dashboard.remainingWeight }} kg</li>
        <li>Progression : {{ dashboard.formattedProgressPercentage }}</li>
    </ul>

    <h2>Prochain jalon</h2>

    {% if dashboard.nextMilestone %}
        <ul>
            <li>Titre : {{ dashboard.nextMilestone.title }}</li>
            <li>Description : {{ dashboard.nextMilestone.description }}</li>
            <li>Objectif : {{ dashboard.nextMilestone.targetValue }} kg</li>
            <li>Encore : {{ dashboard.nextMilestone.remainingWeight }} kg</li>
        </ul>
    {% else %}
        <p>Aucun jalon restant 🎉</p>
    {% endif %}

    <h2>Derniers repas</h2>

    {% for meal in dashboard.recentMeals %}

        <div>
            <strong>{{ meal.mealType.value }}</strong>
            <br>
            {{ meal.description }}
            <br>
            {{ meal.eatenAt|date('d/m/Y H:i') }}
        </div>

    {% else %}

        <p>Aucun repas enregistré.</p>

    {% endfor %}

    <h2>Hydratation</h2>

    {% for drink in dashboard.recentDrinks %}

        <div>
            {{ drink.drinkType.value }}
            -
            {{ drink.quantity }} ml

            {% if drink.description %}
                <br>
                {{ drink.description }}
            {% endif %}
        </div>

    {% else %}

        <p>Aucune boisson enregistrée.</p>

    {% endfor %}

    <h2>Dernier bilan</h2>

    {% if dashboard.dailyCheckin %}

        <p>
            📅 {{ dashboard.dailyCheckin.date|date('d/m/Y') }}
        </p>

        <p>
            🙂 Humeur :
            {{ dashboard.dailyCheckin.moodLevel }}/10
        </p>

        <p>
            ⚡ Énergie :
            {{ dashboard.dailyCheckin.energyLevel }}/10
        </p>

        <p>
            😤 Frustration :
            {{ dashboard.dailyCheckin.frustrationLevel }}/10
        </p>

        {% if dashboard.dailyCheckin.painLevel %}
            <p>
                🦵 Douleur :
                {{ dashboard.dailyCheckin.painLevel }}/10
            </p>
        {% endif %}

        {% if dashboard.dailyCheckin.note %}
            <p>
                📝 {{ dashboard.dailyCheckin.note }}
            </p>
        {% endif %}

    {% else %}

        <p>Aucun bilan enregistré.</p>

    {% endif %}

    <h2>Sommeil</h2>

    {% if dashboard.sleep %}

        <p>
            📅 Nuit du {{ dashboard.sleep.date|date('d/m/Y') }}
        </p>

        <p>
            🌙 Coucher :
            {{ dashboard.sleep.bedTime|date('H:i') }}
        </p>

        <p>
            🌅 Réveil :
            {{ dashboard.sleep.wakeUpTime|date('H:i') }}
        </p>

        <p>
            💤 Durée :
            {{ dashboard.sleep.durationHours }}h
            {{ '%02d'|format(dashboard.sleep.durationRemainingMinutes) }}min
        </p>

        <p>
            ⭐ Qualité :
            {{ dashboard.sleep.quality }}/10
        </p>

        {% if dashboard.sleep.note %}
            <p>
                📝 {{ dashboard.sleep.note }}
            </p>
        {% endif %}

    {% else %}

        <p>Aucune nuit enregistrée.</p>

    {% endif %}

    <h2>Activités récentes</h2>

    {% if dashboard.recentActivities is not empty %}

        {% for activity in dashboard.recentActivities %}

            <div>
                <p>
                    📅 {{ activity.date|date('d/m/Y') }}
                </p>

                <p>
                    🚶 {{ activity.description }}
                </p>

                {% if activity.painLevel %}
                    <p>
                        🦵 Douleur :
                        {{ activity.painLevel }}/10
                    </p>
                {% endif %}

                {% if activity.note %}
                    <p>
                        📝 {{ activity.note }}
                    </p>
                {% endif %}
            </div>

        {% endfor %}

    {% else %}

        <p>Aucune activité enregistrée.</p>

    {% endif %}
{% endblock %}
