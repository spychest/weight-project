{% extends 'base.html.twig' %}

{% block title %}Hydratation{% endblock %}

{% block body %}
    <div class="graph-detail-page">
        <header class="graph-header">
            <div>
                <h1>Hydratation</h1>
                <p>Visualise tes quantités bues sur la période de ton choix.</p>
            </div>

            <a href="{{ path('app_graph') }}" class="dashboard-button">
                ← Retour aux graphiques
            </a>
        </header>

        <section class="graph-detail-card">
            <div class="graph-period-form">
                <div>
                    <label for="hydrationStartDate">Du</label>
                    <input type="date" id="hydrationStartDate">
                </div>

                <div>
                    <label for="hydrationEndDate">Au</label>
                    <input type="date" id="hydrationEndDate">
                </div>
            </div>

            <div class="graph-detail-container">
                <canvas id="hydrationDetailChart"></canvas>
            </div>

            <div class="graph-detail-stats">
                <div>
                    <span>Moyenne / jour</span>
                    <strong id="hydrationAverage">—</strong>
                </div>

                <div>
                    <span>Total</span>
                    <strong id="hydrationTotal">—</strong>
                </div>

                <div>
                    <span>Jours renseignés</span>
                    <strong id="hydrationDays">—</strong>
                </div>

                <div>
                    <span>Minimum</span>
                    <strong id="hydrationMin">—</strong>
                </div>

                <div>
                    <span>Maximum</span>
                    <strong id="hydrationMax">—</strong>
                </div>
            </div>
        </section>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const hydrationData = {{ hydrationData|json_encode|raw }};
        const hydrationReference = 2500;

        const startDateInput = document.getElementById('hydrationStartDate');
        const endDateInput = document.getElementById('hydrationEndDate');

        const averageElement = document.getElementById('hydrationAverage');
        const totalElement = document.getElementById('hydrationTotal');
        const daysElement = document.getElementById('hydrationDays');
        const minElement = document.getElementById('hydrationMin');
        const maxElement = document.getElementById('hydrationMax');

        let hydrationChart = null;

        function formatDate(date) {
            return date.toLocaleDateString('fr-FR', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            });
        }

        function getDailyData() {
            if (!startDateInput.value || !endDateInput.value) {
                return [];
            }

            const totals = {};

            hydrationData.forEach(entry => {
                if (
                    entry.date >= startDateInput.value &&
                    entry.date <= endDateInput.value
                ) {
                    totals[entry.date] = (totals[entry.date] ?? 0) + entry.quantity;
                }
            });

            const result = [];

            const currentDate = new Date(`${startDateInput.value}T00:00:00`);
            const endDate = new Date(`${endDateInput.value}T00:00:00`);

            while (currentDate <= endDate) {
                const year = currentDate.getFullYear();
                const month = String(currentDate.getMonth() + 1).padStart(2, '0');
                const day = String(currentDate.getDate()).padStart(2, '0');

                const key = `${year}-${month}-${day}`;

                result.push({
                    date: key,
                    label: formatDate(currentDate),
                    quantity: totals[key] ?? null
                });

                currentDate.setDate(currentDate.getDate() + 1);
            }

            return result;
        }

        function updateStats(entries) {
            const quantities = entries
                .filter(entry => entry.quantity !== null)
                .map(entry => entry.quantity);

            daysElement.textContent = quantities.length;

            if (quantities.length === 0) {
                averageElement.textContent = '—';
                totalElement.textContent = '—';
                minElement.textContent = '—';
                maxElement.textContent = '—';

                return;
            }

            const total = quantities.reduce((sum, quantity) => sum + quantity, 0);
            const average = total / quantities.length;

            averageElement.textContent = `${Math.round(average)} ml`;
            totalElement.textContent = `${Math.round(total)} ml`;
            minElement.textContent = `${Math.min(...quantities)} ml`;
            maxElement.textContent = `${Math.max(...quantities)} ml`;
        }

        function updateChart() {
            const entries = getDailyData();

            hydrationChart.data.labels = entries.map(entry => entry.label);

            hydrationChart.data.datasets[0].data =
                entries.map(entry => entry.quantity);

            hydrationChart.data.datasets[1].data =
                entries.map(() => hydrationReference);

            hydrationChart.update();

            updateStats(entries);
        }

        function initializeDates() {
            if (hydrationData.length === 0) {
                return;
            }

            startDateInput.value = hydrationData[0].date;
            endDateInput.value = hydrationData[hydrationData.length - 1].date;
        }

        hydrationChart = new Chart(
            document.getElementById('hydrationDetailChart'),
            {
                type: 'bar',
                data: {
                    labels: [],
                    datasets: [
                        {
                            label: 'Hydratation',
                            data: [],
                            borderWidth: 1
                        },
                        {
                            label: 'Repère : 2,5 L/jour',
                            type: 'line',
                            data: [],
                            borderWidth: 2,
                            pointRadius: 0,
                            tension: 0,
                            fill: false
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Quantité (ml)'
                            }
                        }
                    }
                }
            }
        );

        startDateInput.addEventListener('change', updateChart);
        endDateInput.addEventListener('change', updateChart);

        initializeDates();
        updateChart();
    </script>
{% endblock %}